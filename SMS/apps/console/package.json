{
  "name": "@fac-isr/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/main.tsx",
      "default": "./dist/assets/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepreview:test": "npm run build",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "harness:e2e": "npm --prefix ../.. run build --workspace @fac-isr/edge-api && npm run build && node e2e/live-edge-harness.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/console.spec.ts --config playwright.config.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --config playwright.config.ts",
    "typecheck": "tsc -p ../../tsconfig.base.json"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "6.4.3"
  }
}
