# Scenario artifacts are hashed byte-for-byte; keep their canonical LF encoding.
scenarios/military_aviation/*.txt text eol=lf
scenarios/military_aviation/*.json text eol=lf

# The browser recognizes console profiles by their exact published byte hash.
matb_integration/suas/presentation/console-profile.v*.json text eol=lf

# Geographic package checksums cover exact bytes on every platform.
webui/frontend/public/scenes/** -text
webui/frontend/public/geography/** -text

# Retained measurement hashes cover the exact artifact bytes.
docs/reports/evidence-performance-2026-09-09/*.json -text

# Instruction transcripts are hashed in the distributed audio manifest.
webui/frontend/public/audio/instructions/openmatb-es*.txt text eol=lf
