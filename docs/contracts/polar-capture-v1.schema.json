{
  "additionalProperties": false,
  "description": "Durable capture state without a Bluetooth address.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "capture_id": {
      "title": "Capture Id",
      "type": "string"
    },
    "purpose_provenance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose Provenance Id"
    },
    "execution_purpose": {
      "default": "study",
      "enum": [
        "practice",
        "study"
      ],
      "title": "Execution Purpose",
      "type": "string"
    },
    "participant_pseudonym": {
      "title": "Participant Pseudonym",
      "type": "string"
    },
    "matb_session_kind": {
      "title": "Matb Session Kind",
      "type": "string"
    },
    "matb_session_id": {
      "title": "Matb Session Id",
      "type": "string"
    },
    "device_alias": {
      "title": "Device Alias",
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "created",
        "starting",
        "capturing",
        "stopping",
        "complete",
        "failed"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "requested_settings": {
      "additionalProperties": true,
      "title": "Requested Settings",
      "type": "object"
    },
    "resolved_settings": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Settings"
    },
    "stream_counters": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Stream Counters",
      "type": "object"
    },
    "gap_count": {
      "default": 0,
      "title": "Gap Count",
      "type": "integer"
    },
    "connection_epoch": {
      "default": 0,
      "title": "Connection Epoch",
      "type": "integer"
    },
    "artifact_state": {
      "default": "none",
      "enum": [
        "none",
        "partial",
        "finalized",
        "incomplete"
      ],
      "title": "Artifact State",
      "type": "string"
    },
    "incomplete_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Incomplete Reasons",
      "type": "array"
    },
    "started_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At Utc"
    },
    "ended_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At Utc"
    }
  },
  "required": [
    "capture_id",
    "participant_pseudonym",
    "matb_session_kind",
    "matb_session_id",
    "device_alias",
    "lifecycle",
    "requested_settings"
  ],
  "title": "PolarCaptureV1",
  "type": "object"
}
