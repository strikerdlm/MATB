{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matb.science/contracts/component-manifest-v1.schema.json",
  "title": "MATB Component Manifest V1",
  "description": "Auditable metadata and capability declarations for an independently distributable MATB component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "component_version",
    "component_kind",
    "stability",
    "distribution",
    "capabilities",
    "requires",
    "python_entrypoint",
    "license_expression"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
    },
    "component_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "component_kind": {
      "enum": ["contracts", "runtime", "research", "console", "physiology", "automation", "simulation", "governance"]
    },
    "stability": {"enum": ["stable", "candidate", "experimental"]},
    "distribution": {"enum": ["core", "optional"]},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
      }
    },
    "python_entrypoint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        {"type": "null"}
      ]
    },
    "license_expression": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
  }
}
