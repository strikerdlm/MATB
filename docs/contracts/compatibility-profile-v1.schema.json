{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strikerdlm.github.io/matb/schemas/compatibility-profile-v1.json",
  "title": "MATB Compatibility Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "status", "selectable", "implementation", "canonical_tasks", "behavior", "scoring", "logging", "extensions", "provenance", "claims", "known_deviations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["software_verified", "candidate_pending_direct_test", "documented_not_selectable"]},
    "selectable": {"type": "boolean"},
    "implementation": {"type": "object", "required": ["name", "version"]},
    "canonical_tasks": {"type": "array", "uniqueItems": true, "items": {"enum": ["SYSMON", "TRACK", "COMM", "RESMAN"]}},
    "behavior": {"type": "object"},
    "scoring": {"type": "object"},
    "logging": {"type": "object"},
    "extensions": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "claims": {
      "type": "object",
      "required": ["software_conformance", "physical_timing", "human_equivalence"],
      "properties": {
        "human_equivalence": {"enum": ["NOT_TESTED", "EQUIVALENT_WITHIN_MARGIN", "CHARACTERIZED_NOT_EQUIVALENT"]}
      }
    },
    "known_deviations": {"type": "array", "items": {"type": "string"}}
  }
}
